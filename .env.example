# ============================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# Wiki Kreative Gen 15.5
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Rellena los valores según tu entorno
# 3. NUNCA subas el archivo .env real a Git (ya está en .gitignore)
# ============================================================

# --- CONFIGURACIÓN DE ENTORNO ---
# Usar 'dev' para desarrollo local (XAMPP) o 'prod' para producción (cPanel)
ENVIRONMENT=dev

# --- BASE DE DATOS WIKI (XAMPP / LOCAL) ---
# Estas credenciales se usan cuando ENVIRONMENT=dev
DEV_DB_HOST=localhost
DEV_DB_NAME=alphadocere_wiki
DEV_DB_USER=root
DEV_DB_PASS=
DEV_DB_PORT=3306

# --- BASE DE DATOS WIKI (PRODUCCIÓN / cPanel) ---
# Estas credenciales se usan cuando ENVIRONMENT=prod
# Solo rellenar si vas a desplegar en el servidor real
PROD_DB_HOST=localhost
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASS=
PROD_DB_PORT=3306

# --- BASE DE DATOS DEL SISTEMA AUTH (INICIO DE SESIÓN Y ROLES) ---
# En desarrollo local, el Auth se conecta al SERVIDOR REMOTO para validar
# usuarios y roles. Solicita estas credenciales al líder del proyecto.
#
# ⚠️ IMPORTANTE: Aunque estés en modo 'dev', esta conexión apunta al
# servidor remoto para que el login funcione igual que en producción.

DEV_AUTH_DB_HOST=___SOLICITAR_AL_LIDER___
DEV_AUTH_DB_NAME=___SOLICITAR_AL_LIDER___
DEV_AUTH_DB_USER=___SOLICITAR_AL_LIDER___
DEV_AUTH_DB_PASS=___SOLICITAR_AL_LIDER___
DEV_AUTH_DB_PORT=3306

PROD_AUTH_DB_HOST=localhost
PROD_AUTH_DB_NAME=
PROD_AUTH_DB_USER=
PROD_AUTH_DB_PASS=
PROD_AUTH_DB_PORT=3306

# --- ID DEL PROYECTO WIKI EN EL SISTEMA AUTH ---
# Este es el proyecto_id de la Wiki en la tabla 'proyectos' del Sistema Auth.
# El valor por defecto es 3. Confirmar con el líder si es diferente.
WIKI_PROYECTO_ID=3

# --- SEGURIDAD CAJA NEGRA (JWT) ---
# Llave secreta para firmar los tokens JWT. Debe ser la misma en todos los entornos.
JWT_SECRET=WikiSecretKey_Gen15_Version2_2026_Secure
JWT_EXPIRY=3600